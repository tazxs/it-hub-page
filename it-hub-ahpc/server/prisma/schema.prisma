generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Newsletter {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())
}

model Program {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String   // JSON stringified for sqlite, or text
  description String   // JSON stringified for sqlite, or text
  category    String
  createdAt   DateTime @default(now())
}
